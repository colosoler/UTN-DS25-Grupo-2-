{
 "compilerOptions" : {
   "target": "ES2020",
   "module": "Node16",
   "outDir": "./dist",
   "rootDir": "./src",
   "strict": true,
   "esModuleInterop" : true,
   "forceConsistentCasingInFileNames" : true,
   "skipLibCheck" : true,
   "moduleResolution" : "node16"
 },
 "include": ["src/**/*"],
 "exclude": ["src/**/*.test.ts", "src/**/*.spec.ts", "src/**/__tests__/**/*"]
}
